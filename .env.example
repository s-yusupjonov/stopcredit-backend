# ---- Server ----
SERVER_PORT=8080

# ---- PostgreSQL (docker-compose + application) ----
DB_HOST=localhost
DB_PORT=5432
DB_NAME=stopcredit
DB_USERNAME=postgres
DB_PASSWORD=1234

# ---- MinIO (docker-compose + application) ----
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=stopcredit-documents

# ---- Default admin (created on first start if no ADMIN exists) ----
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme

# ---- CORS ----
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ---- JWT (secret must be at least 32 characters) ----
JWT_SECRET=replace-me-with-a-long-random-string-32+chars
JWT_EXPIRATION_MINUTES=480

# ---- Active Directory / LDAP (fallback auth for usernames not found/local in `users`) ----
LDAP_URL=ldap://your-dc-host:389
LDAP_BASE=dc=example,dc=com
LDAP_MANAGER_DN=cn=svc-account,ou=service-accounts,dc=example,dc=com
LDAP_MANAGER_PASSWORD=replace-me
LDAP_USER_SEARCH_BASE=ou=users,dc=example,dc=com
LDAP_USER_SEARCH_FILTER=(sAMAccountName={0})

# ---- Business rules ----
CREDIT_REVIEW_DEADLINE_DAYS=3
